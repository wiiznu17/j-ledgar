# Database
POSTGRES_USER=ledger_admin
POSTGRES_PASSWORD=ledger_password
POSTGRES_DB=jledger_db

# Redis
REDIS_PASSWORD=redis_password

# Security & Secrets
JWT_SECRET="jledger-local-dev-jwt-secret"
JWT_ACCESS_SECRET="jledger_local_dev_access_secret_2024"
JWT_REFRESH_SECRET="jledger_local_dev_refresh_secret_2024"
JWT_REGISTRATION_SECRET="jledger_local_dev_reg_secret_2024"

CUSTOMER_JWT_SECRET="jledger_local_dev_access_secret_2024"
CUSTOMER_REFRESH_SECRET="jledger_local_dev_refresh_secret_2024"
CUSTOMER_REGISTRATION_SECRET="jledger_local_dev_reg_secret_2024"

ADMIN_JWT_SECRET="jledger-admin-super-secret-2024-dev-key-32chars"
ADMIN_REFRESH_SECRET="jledger-admin-refresh-super-secret-2024-dev-key-32chars"

KYC_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
PII_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

AWS_S3_BUCKET_NAME="j-ledger-kyc-bucket"
JLEDGER_INTERNAL_SECRET=jledger_ecosystem_secret_2024

# Throttler / Rate Limiting
THROTTLE_TTL_DEFAULT=60000
THROTTLE_LIMIT_DEFAULT=100
THROTTLE_TTL_REG_INIT=300000
THROTTLE_LIMIT_REG_INIT=10
THROTTLE_TTL_REG_VERIFY=180000
THROTTLE_LIMIT_REG_VERIFY=10
THROTTLE_TTL_LOGIN=900000
THROTTLE_LIMIT_LOGIN=10

# Infrastructure
JLEDGER_EUREKA_ZONE=http://eureka-server:8761/eureka/
JLEDGER_DATASOURCE_URL=jdbc:postgresql://postgres:5432/jledger_db
JLEDGER_REDIS_ADDRESS=redis://redis:6379
JLEDGER_KAFKA_BOOTSTRAP_SERVERS=kafka:29092
API_GATEWAY_URL=http://api-gateway:8080

# Portal & Admin Configuration
JLEDGER_ALLOWED_ORIGINS=*
JLEDGER_ADMIN_EMAIL=admin@jledger.com
JLEDGER_ADMIN_PASSWORD=Admin@123
INTERNAL_API_URL=http://admin-api:3001

# Providers
SMS_PROVIDER_TYPE="mock"
KYC_OCR_PROVIDER_TYPE="mock"
KYC_FACE_PROVIDER_TYPE="mock"
STORAGE_PROVIDER_TYPE="mock"

# Google Cloud Vision
GOOGLE_APPLICATION_CREDENTIALS="/app/secrets/google-key.json"

# Firebase
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxx@your-project.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# AWS & S3 Storage
AWS_REGION="ap-southeast-1"
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret-key"

S3_BUCKET="j-ledger-kyc-bucket"
S3_ENDPOINT=""
S3_ACCESS_KEY="your-aws-access-key"
S3_SECRET_KEY="your-aws-secret-key"
S3_REGION="ap-southeast-1"

# Kafka Brokers
KAFKA_BROKERS=kafka:29092

# KYC match thresholds
KYC_MIN_SIMILARITY_SCORE=80.0
KYC_MIN_LIVENESS_CONFIDENCE=90.0

# Stripe Payments
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
