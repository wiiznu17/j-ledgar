# Database Configuration
POSTGRES_USER=ledger_admin
POSTGRES_PASSWORD=your_secure_random_password_here
POSTGRES_DB=jledger_db

# Redis Configuration
REDIS_PASSWORD=your_secure_random_password_here

# JWT Secrets - Use: openssl rand -hex 32
JWT_SECRET=your_random_64_char_hex_string_here
JWT_ACCESS_SECRET=your_random_64_char_hex_string_here
JWT_REFRESH_SECRET=your_random_64_char_hex_string_here
JWT_REGISTRATION_SECRET=your_random_64_char_hex_string_here

# KYC Encryption Key - Use: openssl rand -hex 32 (for AES-256)
KYC_ENCRYPTION_KEY=your_random_64_char_hex_string_here

# Internal Service Communication - Use: openssl rand -hex 32
JLEDGER_INTERNAL_SECRET=your_random_64_char_hex_string_here

# Rate Limiting
THROTTLE_TTL_DEFAULT=60000
THROTTLE_LIMIT_DEFAULT=100
THROTTLE_TTL_REG_INIT=300000
THROTTLE_LIMIT_REG_INIT=5
THROTTLE_TTL_REG_VERIFY=180000
THROTTLE_LIMIT_REG_VERIFY=3
THROTTLE_TTL_LOGIN=900000
THROTTLE_LIMIT_LOGIN=3

# Admin Credentials - MUST CHANGE AFTER FIRST LOGIN
JLEDGER_ADMIN_EMAIL=admin@jledger.com
JLEDGER_ADMIN_PASSWORD=your_secure_random_password_here

# CORS - Restrict to actual origins
JLEDGER_ALLOWED_ORIGINS=https://potayyr.site

# E-KYC Providers
SMS_PROVIDER_TYPE=mock
KYC_OCR_PROVIDER_TYPE=mock
KYC_FACE_PROVIDER_TYPE=mock
STORAGE_PROVIDER_TYPE=mock

# AWS (create NEW IAM user with minimal permissions, do NOT use root)
# AWS_REGION=ap-southeast-1
# AWS_ACCESS_KEY_ID=your_new_iam_user_access_key
# AWS_SECRET_ACCESS_KEY=your_new_iam_user_secret_key

# Firebase (create NEW service account, do NOT reuse exposed key)
# FIREBASE_PROJECT_ID=your_new_project_id
# FIREBASE_CLIENT_EMAIL=your_new_service_account_email
# FIREBASE_PRIVATE_KEY=your_new_private_key_pem_encoded
