# Database
POSTGRES_USER=ledger_admin
POSTGRES_PASSWORD=your_secure_random_password_here
POSTGRES_DB=jledger_db

# Redis
REDIS_PASSWORD=your_secure_random_password_here

# Kafka
KAFKA_BROKERS=kafka:29092

# Security & Secrets
PII_ENCRYPTION_KEY=your_random_64_char_hex_string_here
JLEDGER_INTERNAL_SECRET=your_random_64_char_hex_string_here

CUSTOMER_JWT_SECRET=your_random_64_char_hex_string_here
CUSTOMER_REFRESH_SECRET=your_random_64_char_hex_string_here
CUSTOMER_REGISTRATION_SECRET=your_random_64_char_hex_string_here

ADMIN_JWT_SECRET=your_random_64_char_hex_string_here
ADMIN_REFRESH_SECRET=your_random_64_char_hex_string_here

# Admin User Setup
JLEDGER_ADMIN_EMAIL=admin@jledger.com
JLEDGER_ADMIN_PASSWORD=your_secure_random_password_here

# CORS
JLEDGER_ALLOWED_ORIGINS=https://potayyr.site,https://admin.potayyr.site

# Providers (mock | aws | s3)
SMS_PROVIDER_TYPE=mock
KYC_OCR_PROVIDER_TYPE=mock
KYC_FACE_PROVIDER_TYPE=mock
STORAGE_PROVIDER_TYPE=mock

# KYC Verification Margin
KYC_MIN_SIMILARITY_SCORE=80.0
KYC_MIN_LIVENESS_CONFIDENCE=90.0

# AWS & S3 Storage
AWS_ACCESS_KEY_ID=your_new_iam_user_access_key
AWS_SECRET_ACCESS_KEY=your_new_iam_user_secret_key
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET_NAME=jledger-kyc-documents


# Stripe Integration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# Notification SMTP Configuration
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@yourdomain.com
SMTP_PASSWORD=your_smtp_password_here
SMTP_FROM="J-Ledger <noreply@yourdomain.com>"
