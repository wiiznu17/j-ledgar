{
  "name": "j-ledger-portal",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:admin": "turbo run dev --filter=admin-web --filter=portal-service",
    "dev:wallet": "turbo run dev --filter=wallet-app --filter=portal-service",
    "dev:admin-web": "turbo run dev --filter=admin-web",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "postinstall": "if [ \"$VERCEL\" = \"1\" ]; then echo 'Skipping turbo generate on Vercel'; else turbo run generate; fi",
    "system:reset": "docker exec -e PGPASSWORD=$$POSTGRES_PASSWORD jledger-postgres psql -U $$POSTGRES_USER -d $$POSTGRES_DB -c 'DROP SCHEMA IF EXISTS finance CASCADE; CREATE SCHEMA finance; GRANT ALL ON SCHEMA finance TO $$POSTGRES_USER;' && cd .. && docker compose -f docker-compose.yml -f docker-compose.dev.yml run --rm finance-migration && cd j-ledger-portal/apps/portal-service && npx prisma migrate reset --force"
  },
  "devDependencies": {
    "@repo/prettier-config": "*",
    "@types/lodash": "^4.17.24",
    "prettier": "^3.7.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "semver": "^7.7.4",
    "turbo": "^2.9.6",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@11.6.0",
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "rxjs": "7.8.2",
    "tslib": "2.6.2",
    "@types/react": "~19.1.10",
    "@types/react-dom": "~19.1.10"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@types/react": "~19.1.10",
    "@types/react-dom": "~19.1.10",
    "rxjs": "7.8.2"
  },
  "optionalDependencies": {
    "@next/swc-darwin-arm64": "^16.2.6",
    "@next/swc-darwin-x64": "^16.2.6"
  }
}
