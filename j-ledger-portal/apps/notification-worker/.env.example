PORT=3001
KAFKA_BROKERS=localhost:9092
KAFKA_CONSUMER_GROUP=notification-worker

# เพิ่ม DATABASE_URL เพื่อให้บันทึก Inbox ได้
DATABASE_URL=postgresql://ledger_admin:ledger_password@localhost:5432/jledger_db

# ตั้งค่า Email (สำหรับใช้ส่งจริง)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@jledger.io

