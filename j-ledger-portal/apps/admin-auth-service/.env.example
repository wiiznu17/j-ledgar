# -----------------------------------------------------------------------------
# Admin Auth Service Environment Variables Example (NestJS)
# Copy this file to .env and fill in the actual values
# -----------------------------------------------------------------------------

# Server Port
PORT=3005

# Database Configuration
# For Hybrid Development (Docker infra + local service):
DATABASE_URL="postgresql://ledger_admin:ledger_password@localhost:5432/jledger_db?schema=admin_auth_schema"

# For Production (Docker):
# DATABASE_URL="postgresql://ledger_admin:ledger_password@postgres:5432/jledger_db?schema=admin_auth_schema"

# Authentication
JWT_ACCESS_SECRET=jledger-local-dev-jwt-access-secret
JWT_REFRESH_SECRET=jledger-local-dev-jwt-refresh-secret
JWT_ACCESS_EXPIRATION=15m

# Internal Security
JLEDGER_INTERNAL_SECRET=jledger_ecosystem_secret_2024

# Redis Configuration (for Hybrid Development)
JLEDGER_REDIS_ADDRESS=redis://localhost:6379
JLEDGER_REDIS_PASSWORD=redis_password

# For Production:
# JLEDGER_REDIS_ADDRESS=redis://redis:6379

# Admin Credentials
JLEDGER_ADMIN_EMAIL=admin@jledger.io
JLEDGER_ADMIN_PASSWORD=password123

NODE_ENV=development
