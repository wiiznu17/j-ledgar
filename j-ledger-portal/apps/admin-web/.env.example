# Required
INTERNAL_API_URL=http://localhost:3000

# Authentication
# Required
ADMIN_JWT_SECRET=jledger-admin-super-secret-2024-dev-key-32chars

# Optional (used by login/refresh flows)
ADMIN_REFRESH_SECRET=jledger-admin-refresh-super-secret-2024-dev-key-32chars

# CSRF Protection
# Required
CSRF_SECRET="jledger-local-dev-csrf-secret"

# For Production Examples:
# INTERNAL_API_URL=https://api.your-domain.com
# INTERNAL_API_URL=http://portal-service:3000
