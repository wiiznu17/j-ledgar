# API Configuration - New Hybrid Modular Architecture
# For Hybrid Development:
# - Portal Service (Auth, KYC): http://localhost:3000
# - Finance Service (Wallets, Transactions): http://localhost:8080
EXPO_PUBLIC_PORTAL_API_URL="http://localhost:3000"
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test
