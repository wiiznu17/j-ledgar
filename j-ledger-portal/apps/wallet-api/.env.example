# -----------------------------------------------------------------------------
# Wallet API Environment Variables Example (NestJS - BFF)
# Copy this file to .env and fill in the actual values
# -----------------------------------------------------------------------------

# Server Port
PORT=3002

# API Gateway Configuration
API_GATEWAY_URL="http://localhost:8080"

# Internal Security
JLEDGER_INTERNAL_SECRET=jledger_ecosystem_secret_2024

# Redis Configuration (for Hybrid Development)
JLEDGER_REDIS_ADDRESS=redis://localhost:6379
JLEDGER_REDIS_PASSWORD=redis_password

# For Production:
# JLEDGER_REDIS_ADDRESS=redis://redis:6379

# Service URLs (for proxy calls)
AUTH_SERVICE_URL="http://localhost:3003"
WALLET_SERVICE_URL="http://localhost:8082"
CORE_SERVICE_URL="http://localhost:8081"
USER_KYC_SERVICE_URL="http://localhost:3004"
NOTIFICATION_SERVICE_URL="http://localhost:3006"

# Rate Limiting Configuration
THROTTLE_TTL_DEFAULT=60000
THROTTLE_LIMIT_DEFAULT=100
THROTTLE_TTL_REG_INIT=300000
THROTTLE_LIMIT_REG_INIT=10
THROTTLE_TTL_REG_VERIFY=180000
THROTTLE_LIMIT_REG_VERIFY=10
THROTTLE_TTL_LOGIN=900000
THROTTLE_LIMIT_LOGIN=10
THROTTLE_TTL_PIN_VERIFY=300000
THROTTLE_LIMIT_PIN_VERIFY=5
THROTTLE_TTL_BIOMETRIC_VERIFY=300000
THROTTLE_LIMIT_BIOMETRIC_VERIFY=10
THROTTLE_TTL_REFRESH_TOKEN=60000
THROTTLE_LIMIT_REFRESH_TOKEN=20
THROTTLE_TTL_ACCOUNT_DELETION=3600000
THROTTLE_LIMIT_ACCOUNT_DELETION=3

NODE_ENV=development
