# -----------------------------------------------------------------------------
# User KYC Service Environment Variables Example (NestJS)
# Copy this file to .env and fill in the actual values
# -----------------------------------------------------------------------------

# Server Port
PORT=3004

# Database Configuration
# For Hybrid Development (Docker infra + local service):
DATABASE_URL="postgresql://ledger_admin:ledger_password@localhost:5432/jledger_db?schema=user_kyc_schema"

# For Production (Docker):
# DATABASE_URL="postgresql://ledger_admin:ledger_password@postgres:5432/jledger_db?schema=user_kyc_schema"

# Internal Security
JLEDGER_INTERNAL_SECRET=jledger_ecosystem_secret_2024

# Redis Configuration (for Hybrid Development)
JLEDGER_REDIS_ADDRESS=redis://localhost:6379
JLEDGER_REDIS_PASSWORD=redis_password

# For Production:
# JLEDGER_REDIS_ADDRESS=redis://redis:6379

# PII Encryption Key (32 bytes for AES-256-GCM)
PII_ENCRYPTION_KEY=your_kyc_encryption_key_32_bytes

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=jledger-uploads

# KYC Providers
KYC_OCR_PROVIDER_TYPE=google
KYC_FACE_PROVIDER_TYPE=aws

# Google Cloud Configuration
GOOGLE_APPLICATION_CREDENTIALS=/path/to/google-key.json

NODE_ENV=development
