// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["user_kyc_schema"]
}

model User {
  id        String   @id @default(uuid())
  userId    String   @unique
  email     String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  kycDocuments KYCDocument[]
  pii          PII[]

  @@map("users")
  @@schema("user_kyc_schema")
}

model KYCDocument {
  id          String   @id @default(uuid())
  userId      String
  documentType String // ID_CARD, PASSPORT, SELFIE, etc.
  status      String   // PENDING, APPROVED, REJECTED
  s3Key       String
  s3Url       String?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("kyc_documents")
  @@schema("user_kyc_schema")
}

model KYCData {
  id                      String   @id @default(uuid())
  userId                  String   @unique
  verificationStatus      String   @default("PENDING") // PENDING, APPROVED, REJECTED
  idCardNumberEncrypted   String?
  idCardName              String?
  thaiNameEncrypted       String?
  prefix                  String?
  idCardToken             String?  @unique // SHA-256 of ID number for deduplication
  idCardImageUrl          String?
  idCardImageSha256       String?
  selfieImageUrl          String?
  selfieImageSha256       String?
  livenessSessionId       String?
  faceMatchScore          Int?
  idCardIssueDate         DateTime?
  idCardExpiryDate        DateTime?
  religion                String?
  reviewNote              String?
  ocrConfidence           Float?
  verifiedAt              DateTime?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@map("kyc_data")
  @@schema("user_kyc_schema")
}

model PII {
  id          String   @id @default(uuid())
  userId      String
  field       String   // FULL_NAME, ID_NUMBER, ADDRESS, etc.
  encryptedData String // Encrypted PII data
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, field])
  @@map("pii")
  @@schema("user_kyc_schema")
}
