PORT=3000
DATABASE_URL=postgresql://ledger_admin:ledger_password@localhost:5432/jledger_db

ADMIN_JWT_SECRET=jledger-admin-super-secret-2024-dev-key-32chars
ADMIN_REFRESH_SECRET=jledger-admin-refresh-super-secret-2024-dev-key-32chars
CUSTOMER_JWT_SECRET=jledger-customer-secret-dev-2024
CUSTOMER_REFRESH_SECRET=jledger-customer-refresh-secret-dev-2024
CUSTOMER_REGISTRATION_SECRET=jledger_local_dev_reg_secret_2024

# Google Cloud (OCR)
GOOGLE_APPLICATION_CREDENTIALS=./google-key.json # Path to JSON key file
GOOGLE_APPLICATION_CREDENTIALS_JSON= # OR raw JSON string from key file

# AWS (S3 & Rekognition)
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET_NAME=jledger-kyc-documents

# KYC Configuration
KYC_MIN_SIMILARITY_SCORE=80.0
KYC_MIN_LIVENESS_CONFIDENCE=90.0

PII_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

JLEDGER_REDIS_ADDRESS=redis://localhost:6379
JLEDGER_REDIS_PASSWORD=redis_password
FINANCE_SERVICE_URL=http://localhost:8081
JLEDGER_INTERNAL_SECRET=default_internal_secret

STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx

KAFKA_BROKERS=localhost:9092
