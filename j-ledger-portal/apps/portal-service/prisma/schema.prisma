// Portal Service Prisma Schema
// Manages: identity, kyc, admin, integration, audit, reporting schemas
// NO foreign keys between schemas - use application-level references

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["identity", "kyc", "admin", "integration", "audit", "reporting"]
}

// ==================== Identity Schema ====================

model User {
  id                String              @id @default(uuid())
  phoneNumber       String              @unique @db.VarChar(15)
  email             String?             @unique
  passwordHash      String?
  pinHash           String?
  biometricKey      String?
  status            UserStatus          @default(ACTIVE)
  registrationState RegistrationState   @default(PENDING)
  pinAttempts       Int                 @default(0)
  pinLockedUntil    DateTime?
  ledgerAccountId   String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  userDevices       UserDevice[]
  refreshSessions   RefreshSession[]
  otpChallenges     OtpChallenge[]
  userConsents      UserConsent[]
  securityEvents    SecurityEvent[]
  userSettings      UserSetting[]

  @@index([phoneNumber])
  @@index([status])
  @@index([registrationState])
  @@index([createdAt])
  @@map("users")
  @@schema("identity")
}

model UserDevice {
  id              String            @id @default(uuid())
  userId          String
  deviceIdentifier String
  deviceName      String?
  deviceType      String?
  osVersion       String?
  appVersion      String?
  trustLevel      DeviceTrustLevel  @default(UNKNOWN)
  lastSeenAt      DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceIdentifier])
  @@map("user_devices")
  @@schema("identity")
}

model RefreshSession {
  id           String   @id @default(uuid())
  userId       String
  deviceId     String?
  tokenHash    String
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime @default(now())

  ipAddress    String?
  userAgent    String?
  deviceType   String?
  location     String?
  lastSeenAt   DateTime?

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("refresh_sessions")
  @@schema("identity")
}

model OtpChallenge {
  id           String   @id @default(uuid())
  userId       String?
  phoneNumber  String
  code         String
  expiresAt    DateTime
  verifiedAt   DateTime?
  attempts     Int      @default(0)
  createdAt    DateTime @default(now())

  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([phoneNumber])
  @@index([expiresAt])
  @@index([createdAt])
  @@map("otp_challenges")
  @@schema("identity")
}

model UserConsent {
  id           String       @id @default(uuid())
  userId       String
  consentType  ConsentType
  acceptedAt   DateTime
  withdrawnAt  DateTime?
  ipAddress    String?
  userAgent    String?

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, consentType])
  @@map("user_consents")
  @@schema("identity")
}

model SecurityEvent {
  id           String           @id @default(uuid())
  userId       String?
  eventType    SecurityEventType
  ipAddress    String?
  userAgent    String?
  metadata     Json?
  createdAt    DateTime         @default(now())

  user         User?            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("security_events")
  @@schema("identity")
}

model UserSetting {
  id        String   @id @default(uuid())
  userId    String
  key       String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@map("user_settings")
  @@schema("identity")
}

model Address {
  id                 String      @id @default(uuid())
  userId             String
  type               AddressType @default(CURRENT)
  label              String?     // e.g., "Home", "Office", "Mom's house"

  line1              String?     // House number, village, lane, road
  line2              String?     // Apartment, suite, etc.
  subdistrict        String?     // ตำบล/แขวง
  district           String?     // อำเภอ/เขต
  province           String?     // จังหวัด
  postalCode         String?     // รหัสไปรษณีย์
  countryCode        String      @default("TH")

  isVerified         Boolean     @default(false)
  verifiedAt         DateTime?
  verificationSource AddressVerificationSource?
  documentRef        String?     // Reference to KYC document

  deletedAt          DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  // Partial unique index (userId, type WHERE deletedAt IS NULL) 
  // is enforced via raw SQL in migration file.
  @@index([userId])
  @@index([isVerified])
  @@map("addresses")
  @@schema("identity")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  BLOCKED
  DELETED

  @@schema("identity")
}

enum RegistrationState {
  PENDING
  PENDING_OTP
  INITIATED
  OTP_VERIFIED
  TC_ACCEPTED
  ID_CARD_UPLOADED
  KYC_VERIFIED
  PROFILE_COMPLETED
  PASSWORD_SET
  CREDENTIALS_SET
  COMPLETED

  @@schema("identity")
}

enum AddressType {
  REGISTERED
  CURRENT
  WORK
  SHIPPING
  BILLING

  @@schema("identity")
}

enum AddressVerificationSource {
  ID_CARD_OCR
  MANUAL
  UTILITY_BILL
  BANK_STATEMENT

  @@schema("identity")
}

enum DeviceTrustLevel {
  UNKNOWN
  TRUSTED
  UNTRUSTED

  @@schema("identity")
}

enum ConsentType {
  TERMS_OF_SERVICE
  PRIVACY_POLICY
  MARKETING_CONSENT
  DATA_PROCESSING

  @@schema("identity")
}

enum SecurityEventType {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  LOGOUT
  LOGOUT_ALL
  PIN_SETUP
  PIN_CHANGE
  PIN_LOCKED
  BIOMETRIC_ENABLED
  BIOMETRIC_DISABLED
  DEVICE_REGISTERED
  DEVICE_REMOVED
  ACCOUNT_LOCKED
  ACCOUNT_UNLOCKED
  PASSWORD_SET
  PASSWORD_RESET
  SUSPICIOUS_ACTIVITY
  REGISTER_INIT_OTP
  REGISTER_OTP_VERIFIED
  REGISTRATION_COMPLETED

  @@schema("identity")
}

// ==================== KYC Schema ====================

model KYCUser {
  id        String   @id @default(uuid())
  userId    String   @unique // Reference to identity.User (no FK)
  email     String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
  @@schema("kyc")
}

model KYCDocument {
  id          String            @id @default(uuid())
  userId      String // Reference to identity.User (no FK)
  documentType String // ID_CARD, PASSPORT, SELFIE, etc.
  status      KYCDocumentStatus @default(PENDING)
  s3Key       String
  s3Url       String?
  metadata    Json?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([userId])
  @@index([status])
  @@index([documentType])
  @@map("kyc_documents")
  @@schema("kyc")
}

model KYCData {
  id                      String                @id @default(uuid())
  userId                  String                @unique // Reference to identity.User (no FK)
  verificationStatus      KYCVerificationStatus @default(PENDING)
  idCardNumberEncrypted   String?
  idCardName              String?  // Keep for backward compatibility/full string
  firstNameTh             String?
  lastNameTh              String?
  firstNameEn             String?
  lastNameEn              String?
  dateOfBirth             DateTime?
  thaiNameEncrypted       String?
  prefix                  String?
  idCardToken             String?  @unique // SHA-256 of ID number for deduplication
  idCardImageUrl          String?
  idCardImageSha256       String?
  selfieImageUrl          String?
  selfieImageSha256       String?
  livenessSessionId       String?
  faceMatchScore          Int?
  idCardIssueDate         DateTime?
  idCardExpiryDate        DateTime?
  religion                String?
  reviewNote              String?
  ocrConfidence           Float?
  verifiedAt              DateTime?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([userId])
  @@index([verificationStatus])
  @@map("kyc_data")
  @@schema("kyc")
}

model PII {
  id          String   @id @default(uuid())
  userId      String // Reference to identity.User (no FK)
  field       String   // FULL_NAME, ID_NUMBER, ADDRESS, etc.
  encryptedData String // Encrypted PII data
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, field])
  @@map("pii")
  @@schema("kyc")
}

enum KYCDocumentStatus {
  PENDING
  APPROVED
  REJECTED

  @@schema("kyc")
}

enum KYCVerificationStatus {
  PENDING
  APPROVED
  REJECTED

  @@schema("kyc")
}

// ==================== Admin Schema ====================

model Staff {
  id               String   @id @default(uuid())
  username         String   @unique
  password         String
  email            String   @unique
  firstName        String
  lastName         String
  isActive         Boolean  @default(true)
  refreshTokenHash String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  staffRoles       StaffRole[]

  @@map("staffs")
  @@schema("admin")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  staffRoles       StaffRole[]
  rolePermissions  RolePermission[]

  @@map("roles")
  @@schema("admin")
}

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  resource    String
  action      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions  RolePermission[]

  @@map("permissions")
  @@schema("admin")
}

model StaffRole {
  id        String   @id @default(uuid())
  staffId   String
  roleId    String
  createdAt DateTime @default(now())

  staff     Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  role      Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([staffId, roleId], name: "staffId_roleId")
  @@map("staff_roles")
  @@schema("admin")
}

model RolePermission {
  id           String   @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId], name: "roleId_permissionId")
  @@map("role_permissions")
  @@schema("admin")
}

// ==================== Integration Schema ====================

model BankIntegration {
  id          BigInt     @id @default(autoincrement())
  bankCode    String
  bankName    String
  apiKey      String
  status      BankStatus @default(ACTIVE)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("banks")
  @@schema("integration")
}

model Merchant {
  id          BigInt         @id @default(autoincrement())
  merchantId  String         @unique
  name        String
  category    String
  status      MerchantStatus @default(ACTIVE)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@map("merchants")
  @@schema("integration")
}

model TopupOrder {
  id                    String           @id @default(uuid())
  userId                String
  amount                Decimal          @db.Decimal(19, 4)
  currency              String           @default("THB")
  status                TopupOrderStatus @default(PENDING)
  stripePaymentIntentId String?          @unique
  clientSecretRef       String?
  idempotencyKey        String           @unique
  financeTransactionId  String?
  processedEventId      String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@index([userId, status])
  @@map("topup_orders")
  @@schema("integration")
}

enum TopupOrderStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELED

  @@schema("integration")
}

enum BankStatus {
  ACTIVE
  INACTIVE

  @@schema("integration")
}

enum MerchantStatus {
  ACTIVE
  INACTIVE

  @@schema("integration")
}

// ==================== Audit Schema ====================

model AuditLog {
  id             String   @id @default(uuid())
  adminUserId    String?
  userId         String?
  action         String
  resourceType   String
  resourceId     String?
  ipAddress      String?
  userAgent      String?
  requestPayload Json?
  responseStatus Int?
  changes        Json?
  reason         String?
  createdAt      DateTime @default(now())

  @@index([userId])
  @@index([adminUserId])
  @@index([createdAt])
  @@map("audit_logs")
  @@schema("audit")
}

// ==================== Reporting Schema ====================

model Report {
  id          BigInt       @id @default(autoincrement())
  reportType  String
  parameters  Json
  status      ReportStatus @default(GENERATING)
  fileUrl     String?
  generatedBy String?
  createdAt   DateTime     @default(now())
  completedAt DateTime?

  @@map("reports")
  @@schema("reporting")
}

enum ReportStatus {
  GENERATING
  COMPLETED
  FAILED

  @@schema("reporting")
}
