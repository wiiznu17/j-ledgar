generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["admin", "audit", "billing", "identity", "integration", "kyc", "loyalty", "merchant", "reporting"]
}

model User {
  id                String                  @id @default(uuid())
  phoneNumber       String                  @unique @db.VarChar(15)
  email             String?                 @unique
  passwordHash      String?
  pinHash           String?
  biometricKey      String?
  status            UserStatus              @default(INACTIVE)
  registrationState RegistrationState       @default(PENDING)
  pinAttempts       Int                     @default(0)
  pinLockedUntil    DateTime?
  ledgerAccountId   String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  notificationPrefs NotificationPreference?
  notifications     Notification[]
  otpChallenges     OtpChallenge[]
  refreshSessions   RefreshSession[]
  securityEvents    SecurityEvent[]
  userConsents      UserConsent[]
  userDevices       UserDevice[]
  userSettings      UserSetting[]

  @@index([phoneNumber])
  @@index([status])
  @@index([registrationState])
  @@index([createdAt])
  @@map("users")
  @@schema("identity")
}

model UserPoint {
  id             String   @id @default(uuid())
  userId         String   @unique
  balance        Int      @default(0)
  lifetimePoints Int      @default(0)
  updatedAt      DateTime @updatedAt

  @@map("user_points")
  @@schema("loyalty")
}

model PointHistory {
  id          String               @id @default(uuid())
  userId      String
  amount      Int
  type        PointTransactionType
  description String?
  referenceId String?
  expiresAt   DateTime?
  createdAt   DateTime             @default(now())

  @@index([userId])
  @@map("point_history")
  @@schema("loyalty")
}

model LoyaltyRule {
  id           String   @id @default(uuid())
  eventType    String   @unique // "TOPUP", "P2P_TRANSFER", "MERCHANT_PAYMENT"
  pointsPerThb Float    @default(0.04) // e.g., 0.04 = 25 THB per 1 point
  minAmount    Float    @default(0)
  maxPoints    Int?
  isActive     Boolean  @default(true)
  isLocked     Boolean  @default(true) // Maintenance mode lock
  description  String?
  updatedAt    DateTime @updatedAt
  updatedBy    String?

  @@map("loyalty_rules")
  @@schema("loyalty")
}

model Brand {
  id          String   @id @default(uuid())
  name        String   @unique
  logoUrl     String?
  description String?
  website     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  partnerId   String?
  deals       Deal[]

  @@map("brands")
  @@schema("loyalty")
}

model DealCategory {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?
  iconUrl     String?
  order       Int     @default(0)
  deals       Deal[]

  @@map("deal_categories")
  @@schema("loyalty")
}

model Deal {
  id             String           @id @default(uuid())
  brandId        String
  categoryId     String
  title          String
  description    String
  termsCondition String?
  pointsRequired Int
  imageUrl       String
  stock          Int              @default(0)
  remainingStock Int              @default(0)
  limitPerUser   Int              @default(1)
  priority       Int              @default(0)
  isActive       Boolean          @default(true)
  startDate      DateTime?
  endDate        DateTime?
  actionPath     String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  redemptions    DealRedemption[]
  brand          Brand            @relation(fields: [brandId], references: [id])
  category       DealCategory     @relation(fields: [categoryId], references: [id])

  @@index([brandId])
  @@index([categoryId])
  @@index([isActive])
  @@map("deals")
  @@schema("loyalty")
}

model DealRedemption {
  id             String           @id @default(uuid())
  dealId         String
  userId         String
  pointsSpent    Int
  redemptionCode String           @unique
  status         RedemptionStatus @default(REDEEMED)
  expiresAt      DateTime?
  usedAt         DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  usedAtMerchantId String?
  deal           Deal             @relation(fields: [dealId], references: [id])

  @@index([dealId])
  @@index([userId])
  @@map("deal_redemptions")
  @@schema("loyalty")
}

model Banner {
  id         String    @id @default(uuid())
  title      String
  imageUrl   String
  actionPath String?
  priority   Int       @default(0)
  isActive   Boolean   @default(true)
  startDate  DateTime?
  endDate    DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("banners")
  @@schema("loyalty")
}

model UserDevice {
  id               String           @id @default(uuid())
  userId           String
  deviceIdentifier String
  deviceName       String?
  deviceType       String?
  osVersion        String?
  appVersion       String?
  trustLevel       DeviceTrustLevel @default(UNKNOWN)
  lastSeenAt       DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  pushToken        String?
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceIdentifier])
  @@map("user_devices")
  @@schema("identity")
}

model RefreshSession {
  id         String    @id @default(uuid())
  userId     String
  deviceId   String?
  tokenHash  String
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  deviceType String?
  ipAddress  String?
  lastSeenAt DateTime?
  location   String?
  userAgent  String?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("refresh_sessions")
  @@schema("identity")
}

model OtpChallenge {
  id          String    @id @default(uuid())
  userId      String?
  phoneNumber String
  code        String
  expiresAt   DateTime
  verifiedAt  DateTime?
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now())
  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([phoneNumber])
  @@index([expiresAt])
  @@index([createdAt])
  @@map("otp_challenges")
  @@schema("identity")
}

model UserConsent {
  id          String      @id @default(uuid())
  userId      String
  consentType ConsentType
  acceptedAt  DateTime
  withdrawnAt DateTime?
  ipAddress   String?
  userAgent   String?
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, consentType])
  @@map("user_consents")
  @@schema("identity")
}

model SecurityEvent {
  id        String            @id @default(uuid())
  userId    String?
  eventType SecurityEventType
  ipAddress String?
  userAgent String?
  metadata  Json?
  createdAt DateTime          @default(now())
  user      User?             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("security_events")
  @@schema("identity")
}

model UserSetting {
  id        String   @id @default(uuid())
  userId    String
  key       String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@map("user_settings")
  @@schema("identity")
}

model Notification {
  id             String   @id @default(uuid())
  userId         String
  title          String
  category       String?
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())
  idempotencyKey String   @unique
  message        String
  metadata       Json?
  path           String?
  referenceId    String?
  type           String
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notifications")
  @@schema("identity")
}

model NotificationPreference {
  userId             String  @id
  pushEnabled        Boolean @default(true)
  emailEnabled       Boolean @default(true)
  securityForceEmail Boolean @default(true)
  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
  @@schema("identity")
}

model Address {
  id                 String                     @id @default(uuid())
  userId             String
  type               AddressType                @default(CURRENT)
  label              String?
  line1              String?
  line2              String?
  subdistrict        String?
  district           String?
  province           String?
  postalCode         String?
  countryCode        String                     @default("TH")
  isVerified         Boolean                    @default(false)
  verifiedAt         DateTime?
  verificationSource AddressVerificationSource?
  documentRef        String?
  deletedAt          DateTime?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  @@index([userId])
  @@index([isVerified])
  @@map("addresses")
  @@schema("identity")
}


model KYCDocument {
  id           String            @id @default(uuid())
  userId       String
  documentType String
  s3Key        String
  s3Url        String?
  metadata     Json?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  status       KYCDocumentStatus @default(PENDING)

  @@index([userId])
  @@index([status])
  @@index([documentType])
  @@map("kyc_documents")
  @@schema("kyc")
}

model KYCData {
  id                    String                @id @default(uuid())
  userId                String                @unique
  idCardNumberEncrypted String?
  idCardName            String?
  firstNameTh           String?
  lastNameTh            String?
  firstNameEn           String?
  lastNameEn            String?
  dateOfBirth           DateTime?
  thaiNameEncrypted     String?
  prefix                String?
  idCardToken           String?               @unique
  idCardImageUrl        String?
  idCardImageSha256     String?
  selfieImageUrl        String?
  selfieImageSha256     String?
  livenessSessionId     String?
  faceMatchScore        Int?
  idCardIssueDate       DateTime?
  idCardExpiryDate      DateTime?
  religion              String?
  reviewNote            String?
  ocrConfidence         Float?
  verifiedAt            DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  verificationStatus    KYCVerificationStatus @default(PENDING)
  prefixEn              String?

  @@index([userId])
  @@index([verificationStatus])
  @@map("kyc_data")
  @@schema("kyc")
}

model PII {
  id            String   @id @default(uuid())
  userId        String
  field         String
  encryptedData String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, field])
  @@map("pii")
  @@schema("kyc")
}

model Staff {
  id               String      @id @default(uuid())
  username         String      @unique
  password         String
  email            String      @unique
  firstName        String
  lastName         String
  isActive         Boolean     @default(true)
  refreshTokenHash String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  resetToken       String?     @unique
  resetTokenExpiry DateTime?
  staffRoles       StaffRole[]

  @@map("staffs")
  @@schema("admin")
}

model Role {
  id              String           @id @default(uuid())
  name            String           @unique
  description     String?
  isSystem        Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]
  staffRoles      StaffRole[]

  @@map("roles")
  @@schema("admin")
}

model Permission {
  id              String           @id @default(uuid())
  name            String           @unique
  description     String?
  resource        String
  action          String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]

  @@map("permissions")
  @@schema("admin")
}

model StaffRole {
  id        String   @id @default(uuid())
  staffId   String
  roleId    String
  createdAt DateTime @default(now())
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, roleId], name: "staffId_roleId")
  @@map("staff_roles")
  @@schema("admin")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId], name: "roleId_permissionId")
  @@map("role_permissions")
  @@schema("admin")
}

model BankIntegration {
  id        BigInt     @id @default(autoincrement())
  bankCode  String
  bankName  String
  apiKey    String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  status    BankStatus @default(ACTIVE)

  @@map("banks")
  @@schema("integration")
}

enum PartnerType {
  SME
  CORPORATE

  @@schema("merchant")
}

model Partner {
  id              String               @id @default(uuid())
  userId          String?
  name            String
  taxId           String?              @unique
  type            PartnerType          @default(SME)
  financeAccounts Json?                // { available: UUID, pending: UUID, fee: UUID }
  isPaymentEnabled Boolean             @default(true)
  isLoyaltyEnabled Boolean             @default(true)
  status          PartnerStatus        @default(PENDING_REVIEW)
  metadata        Json?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  merchants       Merchant[]
  applications    MerchantApplication[]
  profile         PartnerProfile?

  @@index([userId])
  @@index([status])
  @@map("partners")
  @@schema("merchant")
}

model PartnerProfile {
  id              String   @id @default(uuid())
  partnerId       String   @unique
  partner         Partner  @relation(fields: [partnerId], references: [id])
  businessNameEn  String?
  category        String?
  contactName     String?
  email           String?
  phone           String?
  address         String?
  addressDetail   String?
  location        Json?    // { lat, lng }
  website         String?
  logoUrl         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("partner_profiles")
  @@schema("merchant")
}

model Merchant {
  id         String   @id @default(uuid())
  partnerId  String
  name       String
  category   String?
  location   Json?    // { lat, lng }
  address    String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  partner    Partner  @relation(fields: [partnerId], references: [id])
  terminals  Terminal[]

  @@index([partnerId])
  @@map("merchants")
  @@schema("merchant")
}

model Terminal {
  id         String         @id @default(uuid())
  merchantId String
  name       String?
  secretKey  String         @unique // HMAC Secret
  hardwareId String?        @unique
  status     TerminalStatus @default(ACTIVE)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  merchant   Merchant       @relation(fields: [merchantId], references: [id])

  @@index([merchantId])
  @@map("terminals")
  @@schema("merchant")
}

model TerminalIdempotencyRecord {
  id              String   @id @default(uuid())
  terminalId      String
  operation       String   // PAYMENT | REDEEM
  idempotencyKey  String
  requestHash     String   // SHA256 of the request body
  responsePayload Json
  status          Int      // HTTP status code
  createdAt       DateTime @default(now())
  expiresAt       DateTime

  @@unique([terminalId, operation, idempotencyKey])
  @@index([expiresAt])
  @@map("terminal_idempotency_records")
  @@schema("merchant")
}

model MerchantApplication {
  id             String            @id @default(uuid())
  partnerId      String
  userId         String
  businessName   String
  businessNameEn String?
  category       String
  salesChannel   String            @default("PHYSICAL_STORE")
  contactName    String
  email          String
  phone          String
  taxId          String
  address        String
  addressDetail  String?
  ownerIdCardNumber String?
  ownerBirthDate    String?
  location       Json?             // { lat, lng }
  images         String[]          @default([])
  status         ApplicationStatus @default(PENDING)

  reviewNote     String?
  reviewedBy     String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  partner        Partner           @relation(fields: [partnerId], references: [id])

  @@index([partnerId])
  @@index([userId])
  @@index([status])
  @@map("merchant_applications")
  @@schema("merchant")
}


model TopupOrder {
  id                    String           @id @default(uuid())
  userId                String
  amount                Decimal          @db.Decimal(19, 4)
  currency              String           @default("THB")
  status                TopupOrderStatus @default(PENDING)
  stripePaymentIntentId String?          @unique
  clientSecretRef       String?
  idempotencyKey        String           @unique
  financeTransactionId  String?
  processedEventId      String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@index([userId, status])
  @@map("topup_orders")
  @@schema("integration")
}

model AuditLog {
  id             String   @id @default(uuid())
  adminUserId    String?
  userId         String?
  action         String
  resourceType   String
  resourceId     String?
  ipAddress      String?
  userAgent      String?
  requestPayload Json?
  responseStatus Int?
  changes        Json?
  reason         String?
  createdAt      DateTime @default(now())

  @@index([userId])
  @@index([adminUserId])
  @@index([createdAt])
  @@map("audit_logs")
  @@schema("audit")
}

model Report {
  id          BigInt       @id @default(autoincrement())
  reportType  String
  parameters  Json
  fileUrl     String?
  generatedBy String?
  createdAt   DateTime     @default(now())
  completedAt DateTime?
  status      ReportStatus @default(GENERATING)

  @@map("reports")
  @@schema("reporting")
}

model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique
  userId        String
  senderName    String?
  senderDetail  String?
  amount        Decimal       @db.Decimal(19, 4)
  tax           Decimal       @default(0) @db.Decimal(19, 4)
  total         Decimal       @db.Decimal(19, 4)
  currency      String        @default("THB")
  status        InvoiceStatus @default(PENDING)
  dueDate       DateTime?
  paidAt        DateTime?
  referenceId   String?
  note          String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  items         InvoiceItem[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("invoices")
  @@schema("billing")
}

model InvoiceItem {
  id        String  @id @default(uuid())
  invoiceId String
  name      String
  quantity  Int     @default(1)
  unitPrice Decimal @db.Decimal(19, 4)
  amount    Decimal @db.Decimal(19, 4)
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_items")
  @@schema("billing")
}

enum PointTransactionType {
  EARN
  REDEEM
  EXPIRE
  ADJUSTMENT

  @@schema("loyalty")
}

enum RedemptionStatus {
  REDEEMED
  USED
  EXPIRED
  CANCELLED

  @@schema("loyalty")
}

enum UserStatus {
  PENDING_APPROVAL
  ACTIVE
  INACTIVE
  SUSPENDED
  BLOCKED
  DELETED
  REJECTED

  @@schema("identity")
}

enum RegistrationState {
  PENDING
  PENDING_OTP
  INITIATED
  OTP_VERIFIED
  TC_ACCEPTED
  ID_CARD_UPLOADED
  ID_CARD_CONFIRMED
  KYC_VERIFIED
  PROFILE_COMPLETED
  PASSWORD_SET
  CREDENTIALS_SET
  COMPLETED

  @@schema("identity")
}

enum AddressType {
  REGISTERED
  CURRENT
  WORK
  SHIPPING
  BILLING

  @@schema("identity")
}

enum AddressVerificationSource {
  ID_CARD_OCR
  MANUAL
  UTILITY_BILL
  BANK_STATEMENT

  @@schema("identity")
}

enum DeviceTrustLevel {
  UNKNOWN
  TRUSTED
  UNTRUSTED

  @@schema("identity")
}

enum ConsentType {
  TERMS_OF_SERVICE
  PRIVACY_POLICY
  MARKETING_CONSENT
  DATA_PROCESSING

  @@schema("identity")
}

enum SecurityEventType {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  LOGOUT
  LOGOUT_ALL
  PIN_SETUP
  PIN_CHANGE
  PIN_LOCKED
  BIOMETRIC_ENABLED
  BIOMETRIC_DISABLED
  DEVICE_REGISTERED
  DEVICE_REMOVED
  ACCOUNT_LOCKED
  ACCOUNT_UNLOCKED
  PASSWORD_SET
  PASSWORD_RESET
  SUSPICIOUS_ACTIVITY
  REGISTER_INIT_OTP
  REGISTER_OTP_VERIFIED
  REGISTRATION_COMPLETED
  PIN_VERIFIED
  PIN_FAILURE
  KYC_SUBMITTED
  KYC_APPROVED
  KYC_REJECTED
  PROFILE_UPDATED
  ADDRESS_UPDATED
  ACCOUNT_DELETION_REQUESTED
  ACCOUNT_DELETED
  CONSENT_WITHDRAWN

  @@schema("identity")
}

enum KYCDocumentStatus {
  PENDING
  APPROVED
  REJECTED

  @@schema("kyc")
}

enum KYCVerificationStatus {
  PENDING
  APPROVED
  REJECTED

  @@schema("kyc")
}

enum TopupOrderStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELED

  @@schema("integration")
}

enum BankStatus {
  ACTIVE
  INACTIVE

  @@schema("integration")
}

enum MerchantStatus {
  ACTIVE
  INACTIVE

  @@schema("integration")
}

enum PartnerStatus {
  PENDING_REVIEW
  ACTIVE
  INACTIVE
  SUSPENDED

  @@schema("merchant")
}

enum TerminalStatus {
  ACTIVE
  REVOKED

  @@schema("merchant")
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED

  @@schema("merchant")
}

enum ReportStatus {
  GENERATING
  COMPLETED
  FAILED

  @@schema("reporting")
}

enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED

  @@schema("billing")
}
