<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permissions for Hardware Integration and Portal Service communication -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- POS Printer Hardware Feature Declaration -->
    <uses-feature android:name="android.hardware.camera" />

    <application
        android:allowBackup="false"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="J-Ledger Smart POS"
        android:roundIcon="@android:drawable/sym_def_app_icon"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">
        
        <activity
            android:name="com.jledger.pos.MainActivity"
            android:exported="true"
            android:label="J-Ledger Smart POS"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Thermal Printer AIDL Driver Mock Background Service -->
        <service
            android:name="com.jledger.pos.service.PrinterMockDriverService"
            android:enabled="true"
            android:exported="false"
            android:process=":printer_service">
            <intent-filter>
                <action android:name="com.jledger.pos.IPrinterService" />
            </intent-filter>
        </service>

    </application>

</manifest>
