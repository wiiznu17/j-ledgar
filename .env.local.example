# -----------------------------------------------------------------------------
# J-Ledger Local Development Environment Variables
# Copy this file to .env.local and fill in the actual values
# Source this file before running services: source .env.local
# -----------------------------------------------------------------------------

# Database Configuration (for wallet-service)
POSTGRES_USER=ledger_admin
POSTGRES_PASSWORD=ledger_password
POSTGRES_DB=jledger_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis Configuration (for wallet-service)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_password

# Eureka Configuration (for wallet-service)
EUREKA_URL=http://localhost:8761/eureka/

# Kafka Configuration (for wallet-service)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Core Service Configuration
JLEDGER_DATASOURCE_URL=jdbc:postgresql://localhost:5432/jledger_db
JLEDGER_DATASOURCE_USERNAME=ledger_admin
JLEDGER_DATASOURCE_PASSWORD=ledger_password
JLEDGER_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
JLEDGER_REDIS_ADDRESS=redis://localhost:6379
JLEDGER_REDIS_PASSWORD=redis_password
JLEDGER_EUREKA_ZONE=http://localhost:8761/eureka/

# JWT Configuration
JWT_ACCESS_SECRET=your-local-jwt-access-secret-change-in-production
JWT_REFRESH_SECRET=your-local-jwt-refresh-secret-change-in-production

# Internal Service Secret
JLEDGER_INTERNAL_SECRET=jledger_ecosystem_secret_2024
